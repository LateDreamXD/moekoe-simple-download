{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "strict": true,
    "target": "esnext",
    "module": "esnext",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "types": [ "@types/node" ]
  },
  "include": [
    "version.ts",
    "*.config.ts",
    ".bin/**/*"
  ]
}
